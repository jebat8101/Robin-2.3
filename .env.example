# Copy to .env: cp .env.example .env
# Configure at least one LLM provider. For local Ollama, keep OLLAMA_BASE_URL below
# (use http://host.docker.internal:11434 when running the Docker image).
# Do not wrap values in quotes. Leave unused keys empty.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
LLAMA_CPP_BASE_URL=
